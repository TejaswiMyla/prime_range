# prime_range
#prime number for in range
n1=int(input("enter the starting number:"))
n2=int(input("enter the ending number:"))
counter=0
l=[]
for i in range(n1,n2+1,1):
    for j in range(1,i+1,1):
        if i%j==0:
            counter+=1
    if counter==2:
        l.append(i)
    counter=0
print ("prime number in given range are:")
print(l)
